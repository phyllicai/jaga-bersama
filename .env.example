# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox > Create App).
# Leave empty to run in mock mode (same response shapes, no network).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_ENV=sandbox            # sandbox (default) or live. This project is only tested on sandbox.
# PAYPAL_CURRENCY=MYR           # MYR needs a Malaysia sandbox business account; use USD otherwise.
# PAYPAL_MODE=mock              # force mock even if keys are set
# PAYPAL_WEBHOOK_ID=            # optional: verify webhook signatures for /api/paypal/webhook

# Optional LLM (any OpenAI-compatible /chat/completions endpoint). Without it, the built-in
# offline parser handles English / Bahasa Melayu / Manglish / 中文 care messages.
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

PORT=8790
# PUBLIC_URL=http://localhost:8790   # used for PayPal Checkout return/cancel URLs
